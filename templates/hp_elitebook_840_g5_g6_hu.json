  "fn_tests": [
    {
      "keys": "Fn + F1",
      "mode": "signal",
      "codes_action": [
        "KEY_F1"
      ],
      "codes_plain": [
        "KEY_SWITCHVIDEOMODE"
      ],
      "see": "Checks the Fn key itself (Fn switches the F-key mode). Signal check only."
    },
    {
      "fkey": "F3",
      "mode": "confirm",
      "see": "Screen brightness DECREASES."
    },
    {
      "fkey": "F4",
      "mode": "confirm",
      "see": "Screen brightness INCREASES."
    },
    {
      "fkey": "F5",
      "mode": "confirm",
      "see": "Speaker MUTE toggles (LED on the key changes, or the volume indicator shows mute)."
    },
    {
      "fkey": "F6",
      "mode": "confirm",
      "see": "Volume DOWN (on-screen volume indicator)."
    },
    {
      "fkey": "F7",
      "mode": "confirm",
      "see": "Volume UP (on-screen volume indicator)."
    },
    {
      "fkey": "F8",
      "mode": "confirm",
      "see": "Microphone MUTE toggles (LED on the key changes, or the indicator shows it)."
    },
    {
      "fkey": "F11",
      "mode": "confirm",
      "see": "Airplane mode toggles (Wi-Fi / airplane indicator). Press it AGAIN to switch it back before answering!"
    },
    {
      "keys": "Fn + Right Shift",
      "mode": "signal",
      "codes": [
        "KEY_SYSRQ",
        "KEY_PRINT"
      ],
      "see": "Print Screen ('prt scr' is printed on the RIGHT SHIFT key - hold Fn, press Right Shift). Signal check only - if nothing arrives press BACKSPACE."
    }
  ]
